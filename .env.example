# Copy to .env and fill in real values. .env is gitignored.
# Loaded by: backend (spring.config.import in application.yml) and
# frontend (Vite, VITE_* keys only).

# ---------- Active profile ----------
# dev    = local MySQL + cloud Redis + cloud Kafka   (work laptop)
# docker = everything on localhost via docker compose (personal laptop)
# local  = H2 + in-memory cache + in-process events  (offline fallback)
SPRING_PROFILES_ACTIVE=dev

# ---------- Database (local MySQL 8) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bankflow
DB_USERNAME=bankflow_app
DB_PASSWORD=replace-me

# Separate schema used by integration tests so they never touch dev data
TEST_DB_NAME=bankflow_test

# ---------- JWT ----------
# Base64, at least 32 bytes decoded. Generate a fresh one per environment.
JWT_SECRET=replace-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---------- Redis (Phase 6 — Redis Cloud) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# ---------- Kafka (Phase 7 — Confluent Cloud) ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------- Frontend ----------
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080

# ---------- Seeded staff logins (dev/docker/local profiles only) ----------
# Hashed by the application at startup; never stored as a hash in git.
ADMIN_EMAIL=admin@bankflow.local
ADMIN_PASSWORD=replace-me
AUDITOR_EMAIL=auditor@bankflow.local
AUDITOR_PASSWORD=replace-me
