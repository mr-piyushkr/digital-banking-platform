# Normalise to LF in the repository; Git checks out native line endings.
* text=auto

*.java   text eol=lf
*.sql    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.sh     text eol=lf
.env*    text eol=lf

*.jar    binary
*.png    binary
*.jpg    binary
*.ico    binary
*.woff2  binary
